Set startStatus = ##class(Ens.Director).StartProduction("GraphFraud.Interop.Production")
If $SYSTEM.Status.IsError(startStatus) { Write "GRAPHFRAUD_PRODUCTION_START_FAILED: ",$SYSTEM.Status.GetErrorText(startStatus),! Halt }
Set demoStatus = ##class(GraphFraud.Interop.Demo).Run()
If $SYSTEM.Status.IsError(demoStatus) { Write "GRAPHFRAUD_DEMO_FAILED: ",$SYSTEM.Status.GetErrorText(demoStatus),! Halt }
Write "GRAPHFRAUD_DEMO_OK",!
Halt
